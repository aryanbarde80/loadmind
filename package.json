{
  "name": "loadmind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LoadMind — an AI-powered intelligent load balancer and algorithm experimentation platform.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "validate": "npm run typecheck && npm test && npm run build",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "e2e": "node scripts/e2e.mjs",
    "visual": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
