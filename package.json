{
  "name": "loadmind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LoadMind — an AI-powered intelligent load balancer and algorithm experimentation platform.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "validate": "npm run typecheck && npm test && npm run build",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "e2e": "node scripts/e2e.mjs",
    "visual": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.3"
  }
}
